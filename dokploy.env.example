# Non-secret Dokploy Application environment only.
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
SITE_NAME=Example Site
SITE_URL=https://example.com
PUBLIC_SITE_URL=https://example.com
DB_DRIVER=libsql
LIBSQL_URL=http://REPLACE_WITH_NATIVE_LIBSQL_APP_NAME:8080
EMDASH_STORAGE_DRIVER=s3
S3_PUBLIC_URL=https://media.example.com
APP_SECRETS_FILE=/run/secrets/app.env
ASTRO_TELEMETRY_DISABLED=1
