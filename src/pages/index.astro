---
const siteName = import.meta.env.SITE_NAME || "Astro + EmDash Starter";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A stateless Astro and EmDash starter for Dokploy." />
    <title>{siteName}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Two-service Dokploy starter</p>
      <h1>{siteName}</h1>
      <p>Astro + EmDash, native libSQL, and Cloudflare R2.</p>
      <a href="/_emdash/admin">Open EmDash admin</a>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f5f7f2; color: #1d2a20; font-family: system-ui, sans-serif; }
  main { width: min(42rem, calc(100% - 2rem)); }
  .eyebrow { color: #4b6b4f; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); line-height: .95; }
  a { color: #245e34; font-weight: 700; }
</style>
